
{
  "$schema": "https://tauri.app",
  "productName": "My App",
  "version": "0.1.0",
  "identifier": "com.example.myapp",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "./dist"
  },
  "app": {
	"windows": [
	  {
		"label": "main",
		"title": "My App",
		"width": 1024,
		"height": 768
	  }
	],
	"security": {
	  "csp": null,
	  "capabilities": ["default"]
	}
  }
}
